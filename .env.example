# ==============================================================================
# ATTACKSURFACE TIMELINE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Rule: NEVER commit real credentials, passwords, or tokens to git.
# Copy this file to .env and provide real values in your deployment platform:
# - Frontend: Netlify Site Settings > Environment variables (NEXT_PUBLIC_* only)
# - Backend: Render / Container service Environment variables (all server keys)
# ==============================================================================

# ── 1. INFRASTRUCTURE & CORE ──────────────────────────────────────────────────
# Primary Database (Supabase PostgreSQL):
# For Direct DDL/Migrations (port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# For Transaction Pooler (port 6543):
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Background Jobs & Caching (Redis / Upstash):
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]

# Application Secret Key (Used for cryptographic token signing, sessions, cookies)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-secure-random-string-in-production

# Environment Mode: development | staging | production
APP_ENV=production

# ── 2. DOMAIN, HOSTING & CORS ─────────────────────────────────────────────────
# Production App URL (No trailing slash)
APP_BASE_URL=https://attacksurface.online

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://attacksurface.online,https://www.attacksurface.online,http://localhost:3000
CORS_ORIGINS=https://attacksurface.online,https://www.attacksurface.online,http://localhost:3000

# Cookie Configuration
COOKIE_DOMAIN=.attacksurface.online
COOKIE_SECURE=true

# ── 3. FRONTEND PUBLIC ENVIRONMENT (NETLIFY) ──────────────────────────────────
# Safe for client browsers. Leave empty if using Netlify /api rewrite proxy.
NEXT_PUBLIC_APP_URL=https://attacksurface.online
NEXT_PUBLIC_API_URL=

# ── 4. SUPABASE (OPTIONAL SERVER-SIDE INTEGRATION) ─────────────────────────────
# Never expose the SERVICE_ROLE_KEY to the browser!
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 5. AUTHENTICATION & OAUTH ─────────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Credentials:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://attacksurface.online/api/v1/auth/google/callback

# ── 6. TRANSACTIONAL EMAIL (RESEND) ───────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=AttackSurface <noreply@attacksurface.online>
RESEND_REPLY_TO=attacksurface.alerts@gmail.com

# ── 7. MONETIZATION & PAYMENTS (RAZORPAY) ──────────────────────────────────────
# Key ID is public-safe; Key Secret & Webhook Secret are STRICTLY SERVER-SIDE.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── 8. INTELLIGENCE & AI PROVIDER CREDENTIALS (ALL SERVER-SIDE) ───────────────
GITHUB_TOKEN=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
NVD_API_KEY=
CENSYS_API_KEY=
CENSYS_ORGANIZATION_ID=
SHODAN_API_KEY=
BUILTWITH_API_KEY=
DOMAINEE_API_KEY=
SUBDOMAINS_FINDER_API_KEY=
STACKBLITZ_API_KEY=

# ── 9. COLLECTOR ENGINE TUNING ────────────────────────────────────────────────
COLLECTOR_USER_AGENT=AttackSurfaceTimeline/0.2 (authorized research; desk@attacksurface.online)
REQUEST_DELAY_SECONDS=1.0
MAX_PAGES_PER_SNAPSHOT=8
RATE_LIMIT_ENABLED=true
