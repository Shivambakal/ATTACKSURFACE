# Infrastructure
DATABASE_URL=postgresql+psycopg://attack:attack@db:5432/attacksurface
REDIS_URL=redis://redis:6379/0
SECRET_KEY=

# API behavior & Domain
APP_BASE_URL=https://attacksurface.online
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://attacksurface.online,https://www.attacksurface.online
COLLECTOR_USER_AGENT=AttackSurfaceTimeline/0.1 (authorized research; desk@attacksurface.online)
REQUEST_DELAY_SECONDS=1
MAX_PAGES_PER_SNAPSHOT=8

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Provider credentials (all optional — app starts without them)
