GEMINI_API_KEY=
NVIDIA_API_KEY=
NVD_API_KEY=

# OAuth (Google OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://attacksurface.online/api/v1/auth/google/callback
